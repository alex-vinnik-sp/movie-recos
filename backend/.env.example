# ==============================================================================
# Movie Recommendation Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ==============================================================================
# Snowflake Configuration (Required for trace_cli.py)
# ==============================================================================
SNOWFLAKE_ACCOUNT=your-snowflake-account
SNOWFLAKE_USER=your-snowflake-user
# Optional: Snowflake password (can use SSO/external auth instead)
# SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_DATABASE=your-database-name
SNOWFLAKE_SCHEMA=your-schema-name
SNOWFLAKE_WAREHOUSE=your-warehouse-name
SNOWFLAKE_ROLE=your-role-name

# ==============================================================================
# API Keys (Required)
# ==============================================================================
# Get your TMDB API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Get your Tavily API key from: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ==============================================================================
# AWS Configuration (Required for Bedrock LLM)
# ==============================================================================
AWS_REGION=us-east-1
# AWS_PROFILE=your-aws-profile  # Optional: uncomment if using named AWS profile

# ==============================================================================
# TruLens Configuration (Optional)
# ==============================================================================
# Enable/disable OpenTelemetry tracing (default: true)
TRULENS_OTEL_TRACING=true

# Use Snowflake's native event table for traces (default: false)
# Set to false to enable feedback evaluations
TRULENS_USE_ACCOUNT_EVENT_TABLE=true

# Enable feedback evaluations: ground truth (MS MARCO) + LLM-based (default: false)
# Requires TRULENS_USE_ACCOUNT_EVENT_TABLE=false
ENABLE_EVALUATIONS=true

# ==============================================================================
# Development/Debug Configuration (Optional)
# ==============================================================================
# TruLens logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use 'true' for DEBUG level (backward compatible)
# Leave empty or unset to use default WARNING level
DEBUG_TRULENS=false

# Enable Snowflake observability in server/MCP modes (default: false)
ENABLE_SNOWFLAKE_OBSERVABILITY=false

# Server port (default: 3000)
PORT=3000
